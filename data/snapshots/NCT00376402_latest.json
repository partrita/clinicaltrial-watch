{"protocolSection": {"identificationModule": {"nctId": "NCT00376402", "orgStudyIdInfo": {"id": "CSLCT-PAN-05-24"}, "organization": {"fullName": "Seqirus", "class": "INDUSTRY"}, "briefTitle": "Study of a Pandemic Influenza Vaccine in Elderly Participants", "officialTitle": "Phase II Study of a Pandemic Influenza Vaccine in Elderly Participants"}, "statusModule": {"statusVerifiedDate": "2008-11", "overallStatus": "COMPLETED", "expandedAccessInfo": {"hasExpandedAccess": false}, "startDateStruct": {"date": "2006-10"}, "completionDateStruct": {"date": "2007-06"}, "studyFirstSubmitDate": "2006-09-11", "studyFirstSubmitQcDate": "2006-09-13", "studyFirstPostDateStruct": {"date": "2006-09-14", "type": "ESTIMATED"}, "lastUpdateSubmitDate": "2016-07-17", "lastUpdatePostDateStruct": {"date": "2016-07-19", "type": "ESTIMATED"}}, "sponsorCollaboratorsModule": {"responsibleParty": {"oldNameTitle": "Dr Russell Basser", "oldOrganization": "CSL Limited"}, "leadSponsor": {"name": "Seqirus", "class": "INDUSTRY"}}, "descriptionModule": {"briefSummary": "The World Health Organisation has warned that an influenza pandemic is inevitable. The avian influenza H5N1 virus strain is one of the leading candidates to cause the next influenza pandemic. The elderly are likely to be a special target group for vaccination; therefore, this study will test the safety and immunogenicity of a H5N1 pandemic influenza vaccine in a healthy elderly population."}, "conditionsModule": {"conditions": ["Influenza"], "keywords": ["Pandemic", "Influenza", "Prevention", "Vaccine", "Prevention of Pandemic Influenza"]}, "designModule": {"studyType": "INTERVENTIONAL", "phases": ["PHASE2"], "designInfo": {"allocation": "RANDOMIZED", "interventionModel": "PARALLEL", "primaryPurpose": "PREVENTION", "maskingInfo": {"masking": "DOUBLE"}}, "enrollmentInfo": {"count": 200}}, "armsInterventionsModule": {"interventions": [{"type": "BIOLOGICAL", "name": "H5N1 Pandemic Influenza Vaccine"}]}, "outcomesModule": {"primaryOutcomes": [{"measure": "Safety and immunogenicity"}]}, "eligibilityModule": {"eligibilityCriteria": "Inclusion Criteria:\n\n* Healthy male and female participants\n\nExclusion Criteria:\n\n* History of clinically significant medical conditions\n* History of Guillain-Barre syndrome or active neurological disease\n* Resident of nursing home or long-term care facility", "healthyVolunteers": true, "sex": "ALL", "minimumAge": "65 Years", "stdAges": ["OLDER_ADULT"]}, "contactsLocationsModule": {"overallOfficials": [{"name": "Peter Richmond, Dr", "affiliation": "Princess Margaret Hospital for Children", "role": "PRINCIPAL_INVESTIGATOR"}], "locations": [{"facility": "CMAX, a division of IDT Australia", "city": "Adelaide", "state": "South Australia", "zip": "5000", "country": "Australia", "geoPoint": {"lat": -34.92866, "lon": 138.59863}}, {"facility": "Princess Margaret Hospital for Children", "city": "Perth", "state": "Western Australia", "zip": "6840", "country": "Australia", "geoPoint": {"lat": -31.95224, "lon": 115.8614}}]}}, "derivedSection": {"miscInfoModule": {"versionHolder": "2026-04-09"}, "conditionBrowseModule": {"meshes": [{"id": "D007251", "term": "Influenza, Human"}], "ancestors": [{"id": "D012141", "term": "Respiratory Tract Infections"}, {"id": "D007239", "term": "Infections"}, {"id": "D009976", "term": "Orthomyxoviridae Infections"}, {"id": "D012327", "term": "RNA Virus Infections"}, {"id": "D014777", "term": "Virus Diseases"}, {"id": "D012140", "term": "Respiratory Tract Diseases"}]}}, "hasResults": false}